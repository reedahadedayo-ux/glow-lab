{
  "framework": null,
  "buildCommand": "node scripts/build-public.js",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 120, "includeFiles": "{server,data}/**" }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "redirects": [
    {
      "source": "/glowlab-skincare/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self' https://*.e2b.app"
        }
      ]
    }
  ],
  "cleanUrls": true
}
