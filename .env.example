# GlowLab Skincare — E-Commerce Automation Environment Variables
# Copy to .env.local for Vercel / Supabase Edge Function deployment.
# Never expose SUPABASE_SERVICE_ROLE_KEY or KLAVIYO_PRIVATE_API_KEY in frontend JS.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key

# Make Webhook URLs (Server-side only)
MAKE_CHECKOUT_STARTED_WEBHOOK_URL=https://hook.eu2.make.com/your-checkout-started-webhook
MAKE_PLACED_ORDER_WEBHOOK_URL=https://hook.eu2.make.com/your-placed-order-webhook

# Optional direct Klaviyo & Airtable credentials (used by Make scenarios)
KLAVIYO_PRIVATE_API_KEY=pk_your_klaviyo_private_api_key
AIRTABLE_BASE_ID=appYourAirtableBaseId
STOREFRONT_ORIGIN=https://glow-lab-puce.vercel.app
