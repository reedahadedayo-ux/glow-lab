# Default is supabase. local is an explicit development-only durable SQLite demo.
DATA_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Existing applied GlowLab schema; do not rerun migrations blindly.
SUPABASE_DB_SCHEMA=glowlab
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Generate with: openssl rand -hex 32. Stable across deployments, at least 32 characters.
SESSION_SECRET=
PORT=3000
# Optional: canonical origin for deployment CSRF checks
APP_ORIGIN=
